        <mxCell id="VF-a1yteRt3T8VojOcaD-18" value="&lt;span style=&quot;font-size: 14px; text-align: left;&quot;&gt;Wk&amp;nbsp; [&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14px; text-align: left; background-color: transparent;&quot;&gt;12288, 128]&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="5XKhNyWqluOw8G5o39U4-38" vertex="1">
