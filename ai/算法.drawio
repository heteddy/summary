rd&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;return&lt;/span&gt; output&lt;br&gt;&lt;br&gt;&lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 使用示例&lt;/span&gt;&lt;br&gt;batch_size&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; seq_len&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; hidden_size &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;2&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;3&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;4&lt;/span&gt;&lt;br&gt;x &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;randn&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;batch_size&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; seq_len&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; hidden_size&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;layer_norm &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; LayerNorm&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/s