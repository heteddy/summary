        <mxCell id="Yvl_u48jdwtjXfyFhl5y-209" value="# python 示例&lt;br&gt;&lt;br&gt;import torch&lt;br&gt;seq_length = 3&lt;br&gt;d_model = 32&lt;br&gt;h = 8&lt;br&gt;d_k = int(d_model/h)&lt;br&gt;Q = torch.randn((seq_length,d_model))&lt;br&gt;print(Q)&lt;br&gt;Q = Q.view(seq_length,h,d_k)&lt;br&gt;print(Q)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="text;align=left;verticalAlign=top;rounded=0;labelBackgroundColor=none;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" parent="Yvl_u48jdwtjXfyFhl5y-263" vertex="1">
