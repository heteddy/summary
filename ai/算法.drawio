        <mxCell id="Yvl_u48jdwtjXfyFhl5y-127" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;维度&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-family: Helvetica, arial, sans-serif; font-size: 14px; caret-color: rgb(0, 0, 0); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;序列长度为&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;font-size: 14px; caret-color: rgb(0, 0, 0); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-wrap-mode: nowrap; print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;L&lt;/code&gt;&lt;span style=&quot;font-family: Helvetica, arial, sans-serif; font-size: 14px; caret-color: rgb(0, 0, 0); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;，那么：&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;print-color-adjust: exact; margin: 15px 0px; padding-left: 30px; caret-color: rgb(0, 0, 0); font-family: Helvetica, arial, sans-serif; font-size: 14px;&quot;&gt;&lt;li style=&quot;print-color-adjust: exact; margin: 0px;&quot;&gt;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;X&lt;/code&gt;&amp;nbsp;的维度是&amp;nbsp;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;[L, d_model]&lt;/code&gt;&lt;/li&gt;&lt;li style=&quot;print-color-adjust: exact; margin: 0px;&quot;&gt;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;Q = X · Wq&lt;/code&gt;&amp;nbsp;-&amp;gt; 维度&amp;nbsp;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;[L, d_k]&lt;/code&gt;&lt;/li&gt;&lt;li style=&quot;print-color-adjust: exact; margin: 0px;&quot;&gt;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;K = X · Wk&lt;/code&gt;&amp;nbsp;-&amp;gt; 维度&amp;nbsp;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;[L, d_k]&lt;/code&gt;&lt;/li&gt;&lt;li style=&quot;print-color-adjust: exact; margin: 0px;&quot;&gt;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;V = X · Wv&lt;/code&gt;&amp;nbsp;-&amp;gt; 维度&amp;nbsp;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;[L, d_v]&lt;/code&gt;&amp;nbsp;(通常&amp;nbsp;&lt;code style=&quot;print-color-adjust: exact; margin: 0px 2px; padding: 0px 5px; text-wrap-mode: nowrap; border: 1px solid rgb(234, 234, 234); border-radius: 3px;&quot;&gt;d_v = d_k&lt;/code&gt;)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;labelBackgroundColor=none;" parent="1" vertex="1">
