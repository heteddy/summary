120, 242);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; keepdim&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;token boolean&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;True&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;        var &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; x&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;var&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;dim&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; keepdim&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;token boolean&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;True&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; unbiased&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;token boolean&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;False&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;        &lt;br&gt;        &lt;span class=&