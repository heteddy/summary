        <mxCell id="5XKhNyWqluOw8G5o39U4-199" value="&lt;pre style=&quot;font: 400 13px / 22px Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; margin: 0px !important; overflow: auto; white-space: pre-wrap; word-break: break-all; padding: 16px; color: rgb(15, 17, 21); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;import&lt;/span&gt; torch&lt;br&gt;&lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;import&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;nn&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;functional &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;as&lt;/span&gt; F&lt;br&gt;&lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;import&lt;/span&gt; math&lt;br&gt;&lt;br&gt;&lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;def&lt;/span&gt; &lt;span class=&quot;token function&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;masked_attention_demo&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;:&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 模拟输入序列（batch_size=1, seq_len=3, hidden_dim=8）&lt;/span&gt;&lt;br&gt;    query &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;randn&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;3&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;8&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    key &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;randn&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;3&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;8&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    value &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;randn&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;3&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;8&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 计算注意力分数&lt;/span&gt;&lt;br&gt;    attention_scores &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;matmul&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;query&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; key&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;transpose&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;2&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt; &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;/&lt;/span&gt; math&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;sqrt&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;8&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token string&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&quot;注意力分数 (应用掩码前):&quot;&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;attention_scores&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 创建因果掩码（下三角矩阵）&lt;/span&gt;&lt;br&gt;    seq_len &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;3&lt;/span&gt;&lt;br&gt;    mask &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;tril&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;ones&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;seq_len&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; seq_len&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;unsqueeze&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token string&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&quot;\n因果掩码:&quot;&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;mask&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 应用掩码：将未来位置设为负无穷&lt;/span&gt;&lt;br&gt;    masked_scores &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; attention_scores&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;masked_fill&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;mask &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;==&lt;/span&gt; &lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;0&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token builtin&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;float&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token string&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&#39;-inf&#39;&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token string&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&quot;\n应用掩码后的分数:&quot;&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;masked_scores&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 应用softmax得到注意力权重&lt;/span&gt;&lt;br&gt;    attention_weights &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; F&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;softmax&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;masked_scores&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; dim&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;token number&quot; style=&quot;color: rgb(183, 107, 1);&quot;&gt;1&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token string&quot; style=&quot;color: rgb(80, 161, 79);&quot;&gt;&quot;\n最终注意力权重:&quot;&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;print&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;attention_weights&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;br&gt;    &lt;span class=&quot;token comment&quot; style=&quot;color: rgb(160, 161, 167); font-style: italic;&quot;&gt;# 应用注意力权重到value&lt;/span&gt;&lt;br&gt;    output &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; torch&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;.&lt;/span&gt;matmul&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;attention_weights&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;,&lt;/span&gt; value&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;token keyword&quot; style=&quot;color: rgb(166, 38, 164);&quot;&gt;return&lt;/span&gt; output&lt;br&gt;result &lt;span class=&quot;token operator&quot; style=&quot;color: rgb(64, 120, 242);&quot;&gt;=&lt;/span&gt; masked_attention_demo&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token punctuation&quot; style=&quot;color: rgb(56, 58, 66);&quot;&gt;)&lt;/span&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
